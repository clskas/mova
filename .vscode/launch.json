{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MOVA Passager (LAN)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main_passenger.dart",
      "args": [
        "--flavor",
        "passenger",
        "--dart-define=API_URL=http://192.168.1.64:3000/api",
        "--dart-define=WS_URL=http://192.168.1.64:3000"
      ]
    },
    {
      "name": "MOVA Chauffeur (LAN)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main_driver.dart",
      "args": [
        "--flavor",
        "driver",
        "--dart-define=API_URL=http://192.168.1.64:3000/api",
        "--dart-define=WS_URL=http://192.168.1.64:3000"
      ]
    },
    {
      "name": "MOVA Passager (émulateur)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main_passenger.dart",
      "args": [
        "--flavor",
        "passenger",
        "--dart-define=API_URL=http://10.0.2.2:3000/api",
        "--dart-define=WS_URL=http://10.0.2.2:3000"
      ]
    },
    {
      "name": "MOVA Chauffeur (émulateur)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main_driver.dart",
      "args": [
        "--flavor",
        "driver",
        "--dart-define=API_URL=http://10.0.2.2:3000/api",
        "--dart-define=WS_URL=http://10.0.2.2:3000"
      ]
    }
  ]
}
