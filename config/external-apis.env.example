# MOVA RDC — Variables APIs externes
# Copier vers config/external-apis.env et compléter

# === Cartographie / géocodage ===
# Mapbox Places — PRIORITAIRE pour l'autocomplete national RDC (recommandé en prod).
# Sans token : repli Nominatim/Photon (couverture OSM RDC souvent incomplète hors grandes villes).
MAPBOX_ACCESS_TOKEN=
MAPBOX_GEOCODE_ENABLED=true
MAPBOX_TIMEOUT_MS=5000
MAPBOX_STYLE_URL=mapbox://styles/mova/midnight-violet

# === Géocodage Nominatim (OpenStreetMap) — repli si Mapbox absent/vide ===
# Requêtes bornées au territoire RDC (lat -13.6..5.6, lon 12..31.5), countrycodes=cd.
# Serveur public par défaut ; en production, préférez une instance Nominatim auto-hébergée.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_ENABLED=true
NOMINATIM_TIMEOUT_MS=5000
NOMINATIM_MIN_INTERVAL_MS=1000
NOMINATIM_USER_AGENT=MOVA-RDC/1.0 (ride-service; https://mova.cd)
NOMINATIM_EMAIL=

# === Géocodage Photon (repli Komoot / OSM — utile si Nominatim bloqué depuis Docker) ===
PHOTON_BASE_URL=https://photon.komoot.io
PHOTON_ENABLED=true
PHOTON_TIMEOUT_MS=8000
# true = Photon avant Nominatim (recommandé dev Docker Windows)
GEOCODE_PREFER_PHOTON=false
GEOCODE_CIRCUIT_BREAKER_MS=300000

# === Routage OSRM (distance routière réelle) ===
# Serveur public par défaut ; en production, préférez une instance OSRM auto-hébergée (Kinshasa/RDC).
# Si OSRM échoue (zones peu cartographiées) : repli Haversine × facteur détour (MARKET_RDC.trip).
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_ENABLED=true
OSRM_TIMEOUT_MS=5000

# === Paiement RDC ===
# Passerelle Mobile Money — switch EXPLICITE (comme SMS_PROVIDER), pas de failover silencieux :
#   serdipay        → SerdiPay Public API (primaire actuel)
#   cinetpay        → CinetPay Checkout (failover recommandé)
#   africastalking  → Africa's Talking Payments (si produit MM RDC activé)
#   legacy          → connecteurs opérateurs directs
#   mock            → pas d'appel gateway (utiliser aussi MOCK_PAYMENTS=true)
# Guide : docs/MOBILE_MONEY_PROVIDER_ALTERNATIVES.md · docs/AFRISOFT_PAYMENT_HUB_API.md
MOBILE_MONEY_GATEWAY=serdipay
# Optionnel plus tard (non implémenté) : MOBILE_MONEY_FAILOVER=cinetpay

# --- SerdiPay Public API (Mobile Money C2B/B2C) — PRIMARY ---
# Après création du compte marchand, SerdiPay envoie les credentials réels.
# Ne pas coller les exemples du PDF (APIWEPANKX, 466551, etc.) — ce sont des placeholders.
# Dashboard app.serdipay.com → CONFIG → API (onglet API) :
#   Merchant Code     → SERDIPAY_MERCHANT_CODE (alias SERDIPAY_MERCHANT_ID)
#   Merchant API ID   → SERDIPAY_API_ID
#   Web domain / IP   → pay.afri-soft.com / VPS whitelist (pas une env var)
# Onglets Change Password / Change PIN (valeurs non affichées sur l’onglet API) :
#   mot de passe portail → SERDIPAY_PASSWORD (+ SERDIPAY_EMAIL du compte marchand)
#   PIN marchand         → SERDIPAY_MERCHANT_PIN
# API password (corps paiement api_password) : PAS un champ séparé chez SerdiPay.
#   Défaut = SERDIPAY_PASSWORD (fiche marchand : Password). Override optionnel :
#   → SERDIPAY_API_PASSWORD
# Public Key SP-P- / Private Key SP-S- / IV : non utilisés par la Public API actuelle
#   (doc « API USSD ») — ne pas les coller dans SERDIPAY_SMS_* .
SERDIPAY_BASE_URL=https://serdipay.com
# Auth get-token : POST /api/public-api/v1/merchant/get-token { email, password }
SERDIPAY_EMAIL=
SERDIPAY_PASSWORD=
# Alias legacy (même rôle que EMAIL / PASSWORD si les nouveaux noms ne sont pas encore posés)
# SERDIPAY_CLIENT_ID=
# SERDIPAY_CLIENT_SECRET=
# Corps paiement : api_id, api_password, merchantCode, merchant_pin, clientPhone, amount, currency, telecom
SERDIPAY_API_ID=
SERDIPAY_API_PASSWORD=
SERDIPAY_MERCHANT_CODE=
SERDIPAY_MERCHANT_PIN=
# Alias optionnel de MERCHANT_CODE
# SERDIPAY_MERCHANT_ID=
SERDIPAY_WEBHOOK_SECRET=
# Chemins Public API (doc SerdiPay)
SERDIPAY_TOKEN_PATH=/api/public-api/v1/merchant/get-token
SERDIPAY_C2B_PATH=/api/public-api/v1/merchant/payment-client
SERDIPAY_B2C_PATH=/api/public-api/v1/merchant/payment-merchant
# Callback à enregistrer chez SerdiPay (hub VPS) :
# SERDIPAY_WEBHOOK_URL=https://pay.afri-soft.com/webhooks/serdipay

# --- CinetPay Checkout (Mobile Money RDC) — FAILOVER ---
# Compte marchand : https://cinetpay.com/ → Integrations → apikey + site_id + secret_key
# Docs : https://docs.cinetpay.com/api/1.0-fr/checkout/initialisation
# Opérateurs CD : OMCD / MPESACD / AIRTELCD (CDF) ; OMCDUSD / MPESACDUSD (USD)
# Ne PAS mettre de vrais secrets ici — uniquement sur le VPS hub (/opt/afrisoft-pay/.env).
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# HMAC x-token sur notify (recommandé)
CINETPAY_SECRET_KEY=
# notify_url enregistré chez CinetPay (GET ping + POST form) — hub public :
CINETPAY_NOTIFY_URL=https://pay.afri-soft.com/webhooks/cinetpay
# Redirection navigateur après paiement (peut être une page app / deep link)
CINETPAY_RETURN_URL=https://pay.afri-soft.com/return
# PROD | TEST (informatif ; même host api-checkout)
CINETPAY_ENV=PROD
# Optionnel — défaut https://api-checkout.cinetpay.com
# CINETPAY_BASE_URL=https://api-checkout.cinetpay.com
# Devise collect : CDF (défaut SENGA) | USD
CINETPAY_CURRENCY=CDF

# --- SerdiPay SMS API (OTP) — doc « sms-api.pdf », distincte du paiement ---
# Credentials SMS (apiId + apiKey) fournis par SerdiPay (WhatsApp/mail) après activation admin.
# Ne PAS réutiliser SERDIPAY_EMAIL/PASSWORD ni SERDIPAY_API_ID paiement.
# Prod : https://serdipay.com  | Staging : https://api.serdipay.cloud
SERDIPAY_SMS_BASE_URL=https://serdipay.com
SERDIPAY_SMS_PATH=/api/sms-api/v1/send
SERDIPAY_SMS_API_ID=
SERDIPAY_SMS_API_KEY=
# Optionnel (compte SMS) — non envoyé dans le corps send
# SERDIPAY_SMS_USERNAME=
# Sender alphanumérique approuvé chez SerdiPay (ex. SerdiPay / MOVA)
SERDIPAY_SMS_SENDER_ID=

# Canal SMS OTP — switch explicite, pas de fallback silencieux :
#   serdipay        → SerdiPay SMS uniquement (SERDIPAY_SMS_API_ID + SERDIPAY_SMS_API_KEY)
#   africastalking  → Africa's Talking uniquement
#   twilio          → Twilio uniquement
# Guide : docs/SMS_OTP_PROVIDERS.md
# Tant que SMS réel n'est pas testé : garder ALLOW_TEST_OTP=true sur mova-auth (OTP 123456, numéros seed)
SMS_PROVIDER=africastalking

# --- Africa's Talking (OTP SMS + secours Mobile Money) ---
# Dashboard : https://account.africastalking.com/
# Username = nom de l'app AT (ex. mova), PAS l'email de connexion
# API Key : Settings → API Key (app production ou sandbox)
# Sender : SMS → Alphanumerics → My Alphanumerics (ou Shortcodes) — ex. MOVA
AFRICAS_TALKING_USERNAME=mova
AFRICAS_TALKING_API_KEY=
# sandbox | production — production requis pour SMS vers vrais +243
AFRICAS_TALKING_ENV=production
AFRICAS_TALKING_SMS_SENDER=MOVA
AFRICAS_TALKING_PRODUCT_NAME=
AFRICAS_TALKING_MM_CALLBACK_URL=https://api.mova.cd/api/payments/africastalking/callback
# --- Legacy direct opérateurs (si MOBILE_MONEY_GATEWAY=legacy) ---
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_CALLBACK_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=

# Mode mock (dev sans clés API)
MOCK_PAYMENTS=true
MOCK_OTP=true
MOCK_SMS=true

# === Communication / OTP / SMS statut course ===
# Production : MOCK_OTP=false + SerdiPay (recommandé) ; Africa's Talking / Twilio en secours
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# === Web Push partenaires (portails restaurant / location) ===
# Générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@mova.cd
# SMS de secours si le portail est fermé (nécessite Africa's Talking ou Twilio)
PARTNER_SMS_ALERTS=false

# === Stockage documents (Supabase Storage — projet senga) ===
# Dashboard : https://supabase.com/dashboard/project/furttqrltkwirdhiktdl
# Région : eu-central-1 (Frankfurt — proche Render Frankfurt / RDC via EU)
SUPABASE_URL=https://furttqrltkwirdhiktdl.supabase.co
# Service role : Project Settings → API → service_role (jamais côté client / jamais commit)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOADS_BUCKET=uploads
SUPABASE_KYC_BUCKET=kyc-docs
# Legacy Cloudinary (optionnel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Auth sociale (optionnel V1.1) ===
GOOGLE_OAUTH_CLIENT_ID=
APPLE_SIGN_IN_KEY_ID=

# === Infra (microservices) ===
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=mova-internal-dev

# Bases par service (docker-compose local)
DATABASE_URL_AUTH=postgresql://mova:mova@localhost:54320/mova_auth
DATABASE_URL_RIDES=postgresql://mova:mova@localhost:54320/mova_rides
DATABASE_URL_PAYMENTS=postgresql://mova:mova@localhost:54320/mova_payments
DATABASE_URL_DRIVERS=postgresql://mova:mova@localhost:54320/mova_drivers
DATABASE_URL_NOTIFICATIONS=postgresql://mova:mova@localhost:54320/mova_notifications

# URLs inter-services (local dev — ports hôte)
# AUTH_SERVICE_URL=http://localhost:3001
# RIDE_SERVICE_URL=http://localhost:3002
# etc.

# URLs inter-services (Docker / Render)
GATEWAY_SERVICE_URL=http://api-gateway:3000
AUTH_SERVICE_URL=http://auth-service:3000
RIDE_SERVICE_URL=http://ride-service:3000
PAYMENT_SERVICE_URL=http://payment-service:3000
DRIVER_SERVICE_URL=http://driver-service:3000
NOTIFICATION_SERVICE_URL=http://notification-service:3000
ADMIN_SERVICE_URL=http://admin-service:3000
GATEWAY_URL=http://localhost:3000

# === Render / CI ===
RENDER_API_KEY=
RENDER_SERVICE_ID_GATEWAY=
RENDER_SERVICE_ID_AUTH=
RENDER_SERVICE_ID_RIDE=
RENDER_SERVICE_ID_PAYMENT=
RENDER_SERVICE_ID_DRIVER=
RENDER_SERVICE_ID_NOTIFICATION=
RENDER_SERVICE_ID_ADMIN=
RENDER_SERVICE_ID_WEB=
PRODUCTION_API_URL=

# === Gateway ===
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# === Apps mobiles — bannière de mise à jour (ride-service, GET /api/public/app-version) ===
# Lever au-dessus de mobile/pubspec.yaml (ex. 1.0.3) après upload Play Internal/Production.
MOBILE_PASSENGER_VERSION=1.0.2
MOBILE_DRIVER_VERSION=1.0.2
MOBILE_MIN_VERSION=1.0.0
PLAY_STORE_PASSENGER_URL=https://play.google.com/store/apps/details?id=cd.mova.mova.passenger
PLAY_STORE_DRIVER_URL=https://play.google.com/store/apps/details?id=cd.mova.mova.driver

# === Mobile / Web ===
NEXT_PUBLIC_API_URL=http://localhost:3000
API_URL=http://localhost:3000

# === Intelligence artificielle (optionnel) ===
# Clés côté serveur uniquement — jamais dans l'app mobile.
# Assistant FAQ : POST /api/ai/chat — OCR KYC : auto après upload permis/assurance/visite technique
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Alternative Azure OpenAI :
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# true = active l'OCR KYC (OpenAI Vision) et les routes IA
AI_ENABLED=false
