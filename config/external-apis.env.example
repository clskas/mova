# MOVA RDC — Variables APIs externes
# Copier vers config/external-apis.env et compléter

# === Cartographie ===
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE_URL=mapbox://styles/mova/midnight-violet

# === Paiement RDC ===
# Passerelle Mobile Money (recommandé RDC) : Africa's Talking
MOBILE_MONEY_GATEWAY=africastalking

# --- Africa's Talking (OTP SMS + Mobile Money) ---
# Dashboard : https://account.africastalking.com/
# Sandbox : username "sandbox" + clé API sandbox
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_ENV=sandbox
# Expéditeur SMS : short code ou alphanumeric approuvé (ex. MOVA)
AFRICAS_TALKING_SMS_SENDER=MOVA
# Nom produit Mobile Money créé dans le dashboard AT
AFRICAS_TALKING_PRODUCT_NAME=
# Webhook confirmation paiement (URL publique HTTPS)
AFRICAS_TALKING_MM_CALLBACK_URL=https://api.mova.cd/api/payments/africastalking/callback

# Canal SMS : africastalking (défaut) | twilio
SMS_PROVIDER=africastalking

# --- Legacy direct opérateurs (si MOBILE_MONEY_GATEWAY=legacy) ---
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_CALLBACK_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=

# Mode mock (dev sans clés API)
MOCK_PAYMENTS=true
MOCK_OTP=true
MOCK_SMS=true

# === Communication / OTP / SMS statut course ===
# Production : MOCK_OTP=false + Africa's Talking (recommandé) ou Twilio (legacy)
# Twilio (legacy — optionnel si SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# === Stockage ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Auth sociale (optionnel V1.1) ===
GOOGLE_OAUTH_CLIENT_ID=
APPLE_SIGN_IN_KEY_ID=

# === Infra (microservices) ===
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=mova-internal-dev

# Bases par service (docker-compose local)
DATABASE_URL_AUTH=postgresql://mova:mova@localhost:54320/mova_auth
DATABASE_URL_RIDES=postgresql://mova:mova@localhost:54320/mova_rides
DATABASE_URL_PAYMENTS=postgresql://mova:mova@localhost:54320/mova_payments
DATABASE_URL_DRIVERS=postgresql://mova:mova@localhost:54320/mova_drivers
DATABASE_URL_NOTIFICATIONS=postgresql://mova:mova@localhost:54320/mova_notifications

# URLs inter-services (local dev — ports hôte)
# AUTH_SERVICE_URL=http://localhost:3001
# RIDE_SERVICE_URL=http://localhost:3002
# etc.

# URLs inter-services (Docker / Render)
GATEWAY_SERVICE_URL=http://api-gateway:3000
AUTH_SERVICE_URL=http://auth-service:3000
RIDE_SERVICE_URL=http://ride-service:3000
PAYMENT_SERVICE_URL=http://payment-service:3000
DRIVER_SERVICE_URL=http://driver-service:3000
NOTIFICATION_SERVICE_URL=http://notification-service:3000
ADMIN_SERVICE_URL=http://admin-service:3000
GATEWAY_URL=http://localhost:3000

# === Render / CI ===
RENDER_API_KEY=
RENDER_SERVICE_ID_GATEWAY=
RENDER_SERVICE_ID_AUTH=
RENDER_SERVICE_ID_RIDE=
RENDER_SERVICE_ID_PAYMENT=
RENDER_SERVICE_ID_DRIVER=
RENDER_SERVICE_ID_NOTIFICATION=
RENDER_SERVICE_ID_ADMIN=
RENDER_SERVICE_ID_WEB=
PRODUCTION_API_URL=

# === Gateway ===
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# === Mobile / Web ===
NEXT_PUBLIC_API_URL=http://localhost:3000
API_URL=http://localhost:3000

# === Intelligence artificielle (optionnel) ===
# Clés côté serveur uniquement — jamais dans l'app mobile.
# Assistant FAQ : POST /api/ai/chat — OCR KYC : auto après upload permis/assurance/visite technique
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Alternative Azure OpenAI :
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# true = active l'OCR KYC (OpenAI Vision) et les routes IA
AI_ENABLED=false
