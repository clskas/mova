# MOVA microservices — copy to .env or use with docker-compose

# Shared
# Production: JWT_SECRET ≥ 32 chars, INTERNAL_API_KEY ≥ 24 chars (services refuse to start otherwise).
JWT_SECRET=dev_secret_change_in_production
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=mova-internal-dev
REDIS_URL=redis://localhost:6379
# Production: set explicit origins (comma-separated). Wildcard + credentials is rejected at bootstrap.
CORS_ORIGIN=*

# Dev mocks — FORBIDDEN in production (MOCK_OTP=true + NODE_ENV=production → process exits)
# Local/CI only: OTP fixe 123456 when MOCK_OTP=true and NODE_ENV≠production
MOCK_OTP=true
MOCK_PAYMENTS=true

# APIs externes (OTP + Mobile Money) → voir config/external-apis.env.example
# Africa's Talking : AFRICAS_TALKING_USERNAME, AFRICAS_TALKING_API_KEY, SMS_PROVIDER=africastalking

# Service URLs (local development)
GATEWAY_SERVICE_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
RIDE_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
DRIVER_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
ADMIN_SERVICE_URL=http://localhost:3006

# Databases (instance Postgres unique — docker compose expose 54320→5432, ou 5432 si port libre)
DATABASE_URL_AUTH=postgresql://mova:mova@localhost:54320/mova_auth
DATABASE_URL_RIDES=postgresql://mova:mova@localhost:54320/mova_rides
DATABASE_URL_PAYMENTS=postgresql://mova:mova@localhost:54320/mova_payments
DATABASE_URL_DRIVERS=postgresql://mova:mova@localhost:54320/mova_drivers
DATABASE_URL_NOTIFICATIONS=postgresql://mova:mova@localhost:54320/mova_notifications

# Per-service DATABASE_URL when running individually (POSTGRES_HOST=localhost:5432 si port 5432 libre):
# auth-service:     DATABASE_URL=postgresql://mova:mova@localhost:54320/mova_auth
# auth-service:     DATABASE_URL=postgresql://mova:mova@localhost:54320/mova_rides
# payment-service:  DATABASE_URL=postgresql://mova:mova@localhost:54320/mova_payments
# driver-service:   DATABASE_URL=postgresql://mova:mova@localhost:54320/mova_drivers
# notification:     DATABASE_URL=postgresql://mova:mova@localhost:54320/mova_notifications

# External APIs (production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ORANGE_MONEY_API_KEY=
MPESA_CONSUMER_KEY=
AIRTEL_MONEY_CLIENT_ID=
FCM_SERVER_KEY=
