# Copy to .env on the VPS:  cp .env.example .env && chmod 600 .env
# Generate secrets: openssl rand -hex 32
# Do NOT commit real SerdiPay keys.
# Live MM keys belong HERE (/opt/afrisoft-pay/.env), not GitHub/Render.

# --- Compose / DB ---
POSTGRES_USER=afrisoft
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=afrisoft_payments

# Image tag after building from Mova repo (docker/payment.Dockerfile)
PAYMENT_IMAGE=afrisoft-pay/payment:local

# --- payment-service (production) ---
NODE_ENV=production
PORT=3000
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS_xxxxxxxxxxxx
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY_MIN_24
CORS_ORIGIN=https://pay.afri-soft.com,https://api.afri-soft.com

# Keep true until SerdiPay merchant credentials are filled AND validated
MOCK_PAYMENTS=true
MOBILE_MONEY_GATEWAY=serdipay
SERDIPAY_BASE_URL=https://apis.serdipay.com

# SerdiPay Public API — dashboard app.serdipay.com → CONFIG → API
# EMAIL/PASSWORD = portail (get-token). API_PASSWORD + PIN = pas sur l'onglet API.
SERDIPAY_EMAIL=
SERDIPAY_PASSWORD=
SERDIPAY_CLIENT_ID=
SERDIPAY_CLIENT_SECRET=
SERDIPAY_API_ID=
SERDIPAY_API_PASSWORD=
SERDIPAY_MERCHANT_CODE=
SERDIPAY_MERCHANT_ID=
SERDIPAY_MERCHANT_PIN=
SERDIPAY_WEBHOOK_SECRET=
SERDIPAY_SMS_PATH=

RIDE_SERVICE_URL=
