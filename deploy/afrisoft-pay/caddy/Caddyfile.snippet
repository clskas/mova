#
# 	handle /webhooks/serdipay* {
# 		rewrite * /api/payments{uri}
# 		reverse_proxy 127.0.0.1:3000
# 	}
#
# 	handle /webhooks/cinetpay* {
# 		rewrite * /api/payments{uri}
# 		reverse_proxy 127.0.0.1:3000
# 	}
#
# 	handle {
# 		reverse_proxy 127.0.0.1:3000
# 	}
# }
