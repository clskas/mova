# Copy to .env on the VPS:  cp .env.example .env && chmod 600 .env
# Generate secrets: openssl rand -hex 32
# Do NOT commit real Africa's Talking / SerdiPay SMS keys.

SMS_IMAGE=afrisoft-sms/hub:local

# --- Hub mode (MOCK until Sender ID / SMS keys ready) ---
SMS_PROVIDER=mock
MOCK_OTP=true
MOCK_RETURN_CODE=true
MOCK_FIXED_OTP=true
MOCK_OTP_CODE=123456
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SEC=60
OTP_PEPPER=CHANGE_ME_OTP_PEPPER_MIN_32_CHARS_xxxxxxxxxxxx

# Apps: app_id:api_key pairs (same app_ids as pay hub when possible)
AFRISOFT_HUB_APPS=senga:CHANGE_ME_SENGA_API_KEY,educongo:CHANGE_ME_EDUCONGO_API_KEY
APP_BRAND_NAMES=senga:SENGA,educongo:Educongo

CORS_ORIGIN=https://sms.afri-soft.com

# --- Fill when provider keys ready; then set SMS_PROVIDER=africastalking|serdipay ---
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SMS_SENDER=
AFRICAS_TALKING_ENV=production

SERDIPAY_SMS_API_ID=
SERDIPAY_SMS_API_KEY=
SERDIPAY_SMS_BASE_URL=https://serdipay.com
SERDIPAY_SMS_PATH=/api/sms-api/v1/send
SERDIPAY_SMS_SENDER_ID=
# Alias accepted by the client: SERDIPAY_SMS_SENDER=
# SERDIPAY_SMS_USERNAME=
