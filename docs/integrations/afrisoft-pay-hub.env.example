# AfriSoft Payment Hub — variables côté APP CLIENTE (placeholders only)
# Copier vers un .env local / privé. Ne jamais committer le fichier rempli.
#
# Source ops (noms seuls) : VPS Hetzner  →  /opt/afrisoft-pay/.env
# Extraire app_id + api_key depuis AFRISOFT_HUB_APPS  (format app_id:api_key,app_id:api_key)
# Transmettre par canal privé — pas GitHub, pas ce dépôt, pas pay.json / sms.json.
#
# Ne PAS copier depuis le VPS (restent sur le hub) :
#   SERDIPAY_*, CINETPAY_*, AFRICAS_TALKING_*, MOCK_PAYMENTS, DATABASE_URL,
#   POSTGRES_*, JWT_SECRET, INTERNAL_API_KEY

# URL publique du hub paiements (pas sms.afri-soft.com, pas api.afri-soft.com)
AFRISOFT_PAY_HUB_URL=https://pay.afri-soft.com
# Alias acceptés par le client SENGA :
# PAY_HUB_URL=https://pay.afri-soft.com
# AFRISOFT_PAY_BASE_URL=https://pay.afri-soft.com

# Identifiant public = partie gauche d'une paire AFRISOFT_HUB_APPS (minuscules, [a-z0-9]+)
AFRISOFT_HUB_APP_ID=CHANGE_ME
# Alias SENGA :
# AFRISOFT_PAY_HUB_APP_ID=CHANGE_ME

# Secret HMAC = partie droite de cette paire
# Header X-AfriSoft-Api-Key  +  HMAC-SHA256 (même valeur)
AFRISOFT_HUB_API_KEY=CHANGE_ME
# Alias SENGA (inutile si vous copiez les noms ci-dessus) :
# AFRISOFT_PAY_HUB_API_KEY=CHANGE_ME

# Secret pour VÉRIFIER les webhooks hub → votre app
# Si AfriSoft ne fournit pas de secret dédié, le hub signe avec l'api_key (même valeur).
AFRISOFT_HUB_WEBHOOK_SECRET=CHANGE_ME
# Alias SENGA :
# AFRISOFT_PAY_HUB_WEBHOOK_SECRET=CHANGE_ME

# URL HTTPS que VOUS exposez — AfriSoft l'enregistre côté hub :
#   AFRISOFT_HUB_WEBHOOK_URL_<APPID>=https://votre-app.example.com/webhooks/afrisoft-payments
# Exemple (à donner à l'ops, pas une variable de votre process) :
# AFRISOFT_HUB_WEBHOOK_URL_EDUCONGO=https://educongo.example.com/webhooks/afrisoft-payments
