# AfriSoft SMS hub — variables côté APP CLIENTE (placeholders only)
# Copier vers un .env local / privé. Ne jamais committer le fichier rempli.
#
# Source ops (noms seuls) : VPS Hetzner  →  /opt/afrisoft-sms/.env
# Extraire app_id + api_key depuis AFRISOFT_HUB_APPS  (format app_id:api_key,app_id:api_key)
# Transmettre par canal privé — pas GitHub, pas ce dépôt, pas sms.json / pay.json.
#
# Ne PAS copier depuis le VPS (restent sur le hub) :
#   SERDIPAY_SMS_*, AFRICAS_TALKING_*, OTP_PEPPER, MOCK_OTP_CODE

# URL publique du hub SMS (pas pay.afri-soft.com, pas api.afri-soft.com)
AFRISOFT_SMS_HUB_URL=https://sms.afri-soft.com
# Alias accepté par le client SENGA :
# SMS_HUB_URL=https://sms.afri-soft.com

# Identifiant public = partie gauche d'une paire AFRISOFT_HUB_APPS (minuscules, [a-z0-9]+)
AFRISOFT_HUB_APP_ID=CHANGE_ME

# Secret HMAC = partie droite de cette paire
# Header X-AfriSoft-Api-Key  +  HMAC-SHA256 (même valeur)
AFRISOFT_HUB_API_KEY=CHANGE_ME
# Alias SENGA (inutile si vous copiez les noms ci-dessus) :
# AFRISOFT_PAY_HUB_API_KEY=CHANGE_ME
