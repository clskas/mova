# AfriSoft SMS / OTP Hub — variables côté APP CLIENTE
# Copier vers .env (hors git). Ne jamais committer le fichier rempli.
#
# Source des valeurs secrètes (ops AfriSoft, en local uniquement) :
#   VPS 178.104.82.66  →  /opt/afrisoft-sms/.env
#   Extraire la paire app_id:api_key depuis AFRISOFT_HUB_APPS
#     AFRISOFT_HUB_APPS=senga:<clé>,educongo:<clé>,votreapp:<clé>
#
# Transmettre le .env rempli par canal privé (voir PRIVATE_NOTE.md).
# Interdit : GitHub, Slack public, tickets, e-mail non chiffré, captures d’écran.
#
# Ne PAS copier depuis le VPS (restent sur le hub uniquement) :
#   SERDIPAY_SMS_API_ID, SERDIPAY_SMS_API_KEY, SERDIPAY_SMS_USERNAME,
#   SERDIPAY_SMS_SENDER_ID, SERDIPAY_SMS_SENDER, SERDIPAY_SMS_BASE_URL, SERDIPAY_SMS_PATH,
#   AFRICAS_TALKING_USERNAME, AFRICAS_TALKING_API_KEY, AFRICAS_TALKING_SMS_SENDER,
#   OTP_PEPPER, MOCK_OTP_CODE

# URL publique du hub SMS (pas pay.afri-soft.com)
AFRISOFT_SMS_HUB_URL=https://sms.afri-soft.com
# Alias accepté par le client SENGA :
# SMS_HUB_URL=https://sms.afri-soft.com

# Identifiant public enregistré dans AFRISOFT_HUB_APPS (minuscules, [a-z0-9]+)
AFRISOFT_HUB_APP_ID=YOUR_APP_ID

# Secret HMAC = clé droite de AFRISOFT_HUB_APPS pour cet app_id
# Header X-AfriSoft-Api-Key  +  HMAC-SHA256 (même valeur)
AFRISOFT_HUB_API_KEY=YOUR_SMS_HUB_API_KEY
# Alias SENGA (même secret que le hub paiements pour app_id=senga uniquement) :
# AFRISOFT_PAY_HUB_API_KEY=YOUR_SMS_HUB_API_KEY
