# URLs Playwright (web + admin)
ADMIN_BASE_URL=http://localhost:3002
WEB_BASE_URL=http://localhost:3001
GATEWAY_URL=http://localhost:3000

# Appium — Android
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
# Nom affiché par `adb devices` (ex. SM_G981V ou emulator-5554)
ANDROID_DEVICE=Android
# Chemin vers l'APK debug passager (construire d'abord, voir docs/testing-e2e.md)
APK_PATH=../mobile/build/app/outputs/flutter-apk/app-passenger-debug.apk
# Si l'app est déjà installée sur l'appareil, laissez USE_INSTALLED_APP=true
USE_INSTALLED_APP=true

# Android SDK (Windows) — requis pour adb et Appium
ANDROID_HOME=C:\Users\Administrator\AppData\Local\Android\Sdk
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.0.8.9-hotspot
