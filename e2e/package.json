{
  "name": "mova-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Tests E2E MOVA — Playwright (web/admin) et Appium (mobile Android)",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:admin": "playwright test --project=admin",
    "test:e2e:web": "playwright test --project=web",
    "test:e2e:report": "playwright show-report",
    "test:mobile": "node mobile/run-smoke.mjs",
    "test:mobile:ps1": "powershell -ExecutionPolicy Bypass -File mobile/run-smoke.ps1",
    "appium:install-drivers": "appium driver install uiautomator2",
    "appium:doctor": "appium driver doctor uiautomator2",
    "appium:start": "appium --relaxed-security",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "appium": "^2.18.0",
    "appium-uiautomator2-driver": "^4.2.0",
    "webdriverio": "^9.12.0"
  }
}
