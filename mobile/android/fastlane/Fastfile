# Fastlane — publication Google Play (track internal testing)

default_platform(:android)

PASSENGER_PACKAGE = "cd.mova.mova.passenger"
DRIVER_PACKAGE = "cd.mova.mova.driver"

def play_json_key
  ENV.fetch("PLAY_STORE_JSON_KEY_PATH", "/tmp/play-store-key.json")
end

def upload_aab_internal(package_name:, aab:)
  UI.user_error!("AAB introuvable : #{aab}") unless File.exist?(aab)
  UI.user_error!("JSON Play Store introuvable : #{play_json_key}") unless File.exist?(play_json_key)

  upload_to_play_store(
    package_name: package_name,
    aab: aab,
    track: "internal",
    release_status: "completed",
    json_key: play_json_key,
    skip_upload_apk: true,
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: true
  )
end

platform :android do
  desc "Publie l'AAB passager (Senga) sur internal testing"
  lane :deploy_internal_passenger do |options|
    aab = options[:aab] || File.expand_path(
      "../../build/app/outputs/bundle/passengerRelease/app-passenger-release.aab",
      __dir__
    )
    upload_aab_internal(package_name: PASSENGER_PACKAGE, aab: aab)
  end

  desc "Publie l'AAB chauffeur (SENGA Driver) sur internal testing"
  lane :deploy_internal_driver do |options|
    aab = options[:aab] || File.expand_path(
      "../../build/app/outputs/bundle/driverRelease/app-driver-release.aab",
      __dir__
    )
    upload_aab_internal(package_name: DRIVER_PACKAGE, aab: aab)
  end

  desc "Publie passager + chauffeur sur internal testing"
  lane :deploy_internal do
    deploy_internal_passenger
    deploy_internal_driver
  end
end
