# Fastlane — publication Google Play (track internal testing)

default_platform(:android)

PASSENGER_PACKAGE = "cd.mova.mova.passenger"
DRIVER_PACKAGE = "cd.mova.mova.driver"

def play_json_key
  ENV.fetch("PLAY_STORE_JSON_KEY_PATH", "/tmp/play-store-key.json")
end

def edit_expired?(err)
  msg = err.to_s
  msg.include?("edit has expired") || msg.include?("Edit has expired")
end

def upload_aab_internal(package_name:, aab:)
  UI.user_error!("AAB introuvable : #{aab}") unless File.exist?(aab)
  UI.user_error!("JSON Play Store introuvable : #{play_json_key}") unless File.exist?(play_json_key)

  attempts = 3
  attempts.times do |i|
    begin
      upload_to_play_store(
        package_name: package_name,
        aab: aab,
        track: "internal",
        release_status: "completed",
        json_key: play_json_key,
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true,
        timeout: 600
      )
      return
    rescue => e
      raise e unless edit_expired?(e) && i < attempts - 1
      wait = 20 * (i + 1)
      UI.important("Play edit expired for #{package_name} — nouvel essai dans #{wait}s (#{i + 2}/#{attempts})")
      sleep(wait)
    end
  end
end

# Production share for a new release: 0.2 = 20 % staged rollout. 1 = everyone.
def play_rollout
  raw = ENV.fetch("PLAY_ROLLOUT", "0.2").to_f
  raw.positive? && raw <= 1 ? raw : 0.2
end

def for_both_apps(label)
  results = {}
  { driver: DRIVER_PACKAGE, passenger: PASSENGER_PACKAGE }.each do |app, package_name|
    begin
      yield package_name
      results[app] = :ok
      UI.success("#{label} OK: #{app}")
    rescue => e
      results[app] = e.message
      UI.error("#{label} FAILED: #{app} — #{e.message}")
    end
  end
  return if results.values.all? { |status| status == :ok }
  summary = results.map { |app, status| "#{app}=#{status == :ok ? 'OK' : 'FAIL'}" }.join(", ")
  UI.user_error!("#{label} partial/complete failure: #{summary}")
end

platform :android do
  desc "Publie l'AAB passager (Senga) sur internal testing"
  lane :deploy_internal_passenger do |options|
    aab = options[:aab] || File.expand_path(
      "../../build/app/outputs/bundle/passengerRelease/app-passenger-release.aab",
      __dir__
    )
    upload_aab_internal(package_name: PASSENGER_PACKAGE, aab: aab)
  end

  desc "Publie l'AAB chauffeur (SENGA Driver) sur internal testing"
  lane :deploy_internal_driver do |options|
    aab = options[:aab] || File.expand_path(
      "../../build/app/outputs/bundle/driverRelease/app-driver-release.aab",
      __dir__
    )
    upload_aab_internal(package_name: DRIVER_PACKAGE, aab: aab)
  end

  desc "Publie chauffeur puis passager sur internal testing (échecs isolés)"
  lane :deploy_internal do
    # Driver first: priority for Internal testing unblock.
    # Rescue each app so one Play permission failure does not skip the other.
    results = {}
    {
      driver: -> { deploy_internal_driver },
      passenger: -> { deploy_internal_passenger }
    }.each do |app, action|
      begin
        action.call
        results[app] = :ok
        UI.success("Play upload OK: #{app}")
      rescue => e
        results[app] = e.message
        UI.error("Play upload FAILED: #{app} — #{e.message}")
      end
    end

    failed = results.select { |_app, status| status != :ok }
    if failed.empty?
      UI.success("Play internal: driver + passenger OK")
    else
      summary = results.map { |app, status| "#{app}=#{status == :ok ? 'OK' : 'FAIL'}" }.join(", ")
      UI.user_error!("Play internal partial/complete failure: #{summary}")
    end
  end

  desc "Écrit « versionName
versionCode » de la piste production (passager) dans PLAY_VERSION_OUT"
  lane :production_version do
    UI.user_error!("JSON Play Store introuvable : #{play_json_key}") unless File.exist?(play_json_key)
    codes = google_play_track_version_codes(
      package_name: PASSENGER_PACKAGE, track: "production", json_key: play_json_key
    )
    names = google_play_track_release_names(
      package_name: PASSENGER_PACKAGE, track: "production", json_key: play_json_key
    )
    code = codes.map(&:to_i).max
    # Play names releases « 208 (1.0.43) » by default; accept a bare « 1.0.43 » too.
    name = names.map { |n| n.to_s[/\d+\.\d+\.\d+/] }.compact.first
    out = ENV.fetch("PLAY_VERSION_OUT", "/tmp/play-production-version")
    if code.nil? || name.nil?
      UI.important("Version production introuvable (codes=#{codes} names=#{names}) — bannières inchangées")
      File.write(out, "")
    else
      UI.success("Play production : #{name}+#{code}")
      File.write(out, "#{name}\n#{code}\n")
    end
  end

  desc "Promouvoir internal → production en déploiement progressif (PLAY_ROLLOUT, 20 % par défaut)"
  lane :promote_internal_to_production do
    UI.user_error!("JSON Play Store introuvable : #{play_json_key}") unless File.exist?(play_json_key)
    rollout = play_rollout
    UI.important("Play production rollout : #{(rollout * 100).round} %")
    for_both_apps("Play promote internal→production") do |package_name|
      upload_to_play_store(
        package_name: package_name,
        track: "internal",
        track_promote_to: "production",
        track_promote_release_status: rollout < 1 ? "inProgress" : "completed",
        rollout: rollout < 1 ? rollout.to_s : nil,
        json_key: play_json_key,
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true
      )
    end
  end

  desc "Passer la release production en cours de déploiement progressif à 100 %"
  lane :complete_production_rollout do
    UI.user_error!("JSON Play Store introuvable : #{play_json_key}") unless File.exist?(play_json_key)
    for_both_apps("Play rollout 100 %") do |package_name|
      code = google_play_track_version_codes(
        package_name: package_name, track: "production", json_key: play_json_key
      ).map(&:to_i).max
      UI.user_error!("Aucune release production pour #{package_name}") if code.nil?
      upload_to_play_store(
        package_name: package_name,
        track: "production",
        version_code: code,
        rollout: "1",
        release_status: "completed",
        json_key: play_json_key,
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true
      )
    end
  end
end
