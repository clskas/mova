<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Standard HTTPS only — required for App Store review submission. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDisplayName</key>
	<string>Senga</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>mova</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>SENGA utilise le micro pour les appels vocaux entre client, livreur et partenaire.</string>
	<key>NSCameraUsageDescription</key>
	<string>SENGA utilise la caméra pour photographier vos colis lors de l'envoi.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SENGA accède à vos photos pour joindre une image au colis.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SENGA utilise votre position pour définir le point de départ ou d'enlèvement, et pour suivre les courses en cours.</string>
	<!-- Required by Apple (ITMS-90683) when location APIs / SDKs may request Always authorization. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>SENGA utilise votre position en arrière-plan pour que les chauffeurs restent localisables pendant une course ou une livraison active.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>SENGA utilise votre position en arrière-plan pour que les chauffeurs restent localisables pendant une course ou une livraison active.</string>
	<!-- Google Sign-In (iOS): ci_set_flavor.sh sets GIDClientID + URL scheme per flavor. -->
	<key>GIDClientID</key>
	<string>GOOGLE_IOS_CLIENT_ID_PLACEHOLDER</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>GOOGLE_IOS_URL_SCHEME_PLACEHOLDER</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
