# Fastlane — TestFlight (app passager)
# L'app chauffeur iOS nécessite un schéma Xcode / bundle ID dédié (non configuré).

default_platform(:ios)

platform :ios do
  desc "Importe certificats via match (lecture seule en CI)"
  lane :sync_certificates do
    match(
      type: "appstore",
      readonly: true,
      app_identifier: "cd.mova.mova"
    )
  end

  desc "Publie l'IPA passager sur TestFlight"
  lane :beta do |options|
    ipa = options[:ipa] || Dir[File.expand_path("../../build/ios/ipa/*.ipa", __dir__)].first
    UI.user_error!("IPA introuvable — exécuter flutter build ipa d'abord") if ipa.nil? || !File.exist?(ipa)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
