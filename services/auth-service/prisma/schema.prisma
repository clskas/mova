generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  DRIVER
  RESTAURANT
  RENTAL_PARTNER
  SUPER_ADMIN
  ADMIN
  SUPPORT
  FINANCE
  CONTENT
  CITY_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_KYC
}

model User {
  id        String     @id @default(uuid())
  phone     String?    @unique
  googleId  String?    @unique
  appleId   String?    @unique
  firstName String?
  lastName  String?
  email     String?
  role      UserRole   @default(PASSENGER)
  status    UserStatus @default(ACTIVE)
  avatarUrl String?
  localPinHash String?
  localPinSetAt DateTime?
  /// CITY_ADMIN: service-area city name matching DRC_SERVICE_AREAS (e.g. "Kinshasa", "Beni").
  managedCity String?
  /// Passager (et autres) : dernière ville d'activité SENGA (course / livraison).
  homeCity  String?
  /// Super-admin overrides of AdminPermission values. Empty = use role defaults.
  adminPermissions String[] @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([homeCity])
  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_codes")
}

enum BlacklistType {
  PHONE
  EMAIL
  USER_ID
  DEVICE
  PLATE
}

/// Blocages identité (login / accès) — distinct du statut SUSPENDED.
model BlacklistEntry {
  id        String        @id @default(uuid())
  type      BlacklistType
  value     String
  reason    String
  expiresAt DateTime?
  active    Boolean       @default(true)
  createdBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([type, value])
  @@index([active, type])
  @@map("blacklist_entries")
}

/// Journal des actions admin (KYC, suspend, tarifs, blacklist, etc.).
model AdminAuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  action       String
  resourceType String
  resourceId   String?
  meta         Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("admin_audit_logs")
}
