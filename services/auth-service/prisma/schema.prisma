generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  DRIVER
  RESTAURANT
  RENTAL_PARTNER
  SUPER_ADMIN
  ADMIN
  SUPPORT
  FINANCE
  CONTENT
  CITY_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_KYC
}

model User {
  id        String     @id @default(uuid())
  phone     String?    @unique
  googleId  String?    @unique
  firstName String?
  lastName  String?
  email     String?
  role      UserRole   @default(PASSENGER)
  status    UserStatus @default(ACTIVE)
  avatarUrl String?
  localPinHash String?
  localPinSetAt DateTime?
  /// CITY_ADMIN: service-area city name matching DRC_SERVICE_AREAS (e.g. "Kinshasa", "Beni").
  managedCity String?
  /// Super-admin overrides of AdminPermission values. Empty = use role defaults.
  adminPermissions String[] @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_codes")
}
