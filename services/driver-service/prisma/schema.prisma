generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  MOTO_TAXI
  STANDARD
  COMFORT
  VIP
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycOcrStatus {
  PENDING
  PROCESSING
  MATCH
  MISMATCH
  UNREADABLE
  SKIPPED
}

enum IncidentType {
  ACCIDENT
  HARASSMENT
  FRAUD
  OTHER
}

model DriverProfile {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  licenseNumber             String?
  idDocumentNumber          String?
  licenseExpiry             DateTime?
  insuranceExpiry           DateTime?
  technicalInspectionExpiry DateTime?
  documentsRenewalPending   Boolean   @default(false)
  documentsRenewalRequestedAt DateTime?
  payoutProvider            String?
  payoutPhone               String?
  charterAcceptedAt         DateTime?
  trainingCompletedAt       DateTime?
  onboardingCompleted       Boolean   @default(false)
  activationPin             String?
  activationPinVerifiedAt   DateTime?
  operatingCity             String    @default("Kinshasa")
  isAvailable   Boolean   @default(false)
  currentLat    Float?
  currentLng    Float?
  ratingAvg     Float     @default(5.0)
  totalRides    Int       @default(0)
  kycStatus     KycStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicles Vehicle[]

  @@map("driver_profiles")
}

model Vehicle {
  id                 String        @id @default(uuid())
  driverProfileId    String
  driverProfile      DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  type               VehicleType
  make               String?
  model              String?
  plateNumber        String
  color              String?
  imageUrl           String?
  typeApprovalStatus KycStatus     @default(PENDING)
  typeApprovalNotes  String?
  typeApprovedAt     DateTime?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())

  @@map("vehicles")
}

model KycDocument {
  id                 String        @id @default(uuid())
  userId             String
  type               String
  url                String
  status             KycStatus     @default(PENDING)
  notes              String?
  ocrStatus          KycOcrStatus  @default(PENDING)
  ocrExtractedExpiry DateTime?
  ocrProfileExpiry   DateTime?
  ocrConfidence      Float?
  ocrNotes           String?
  ocrCheckedAt       DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@map("kyc_documents")
}

model Incident {
  id          String       @id @default(uuid())
  userId      String
  rideId      String?
  type        IncidentType
  description String
  status      String       @default("OPEN")
  createdAt   DateTime     @default(now())

  @@map("incidents")
}
