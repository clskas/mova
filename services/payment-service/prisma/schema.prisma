generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  WALLET
  ORANGE_MONEY
  MPESA
  AIRTEL_MONEY
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id            String        @id @default(uuid())
  rideId        String        @unique
  userId        String
  amountCdf     Int
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  providerRef   String?
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

/// Intentions multi-apps du hub VPS (COLLECT/PAYOUT). Ledger wallet SENGA reste sur Render.
model HubPayment {
  id             String    @id
  appId          String
  reference      String
  idempotencyKey String?
  amountCdf      Int
  currency       String    @default("CDF")
  phone          String
  telecom        String
  purpose        String?
  metadata       Json?
  status         String    @default("PENDING")
  providerRef    String?
  failureReason  String?
  kind           String    @default("COLLECT")
  notifiedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([appId, reference])
  @@unique([appId, idempotencyKey])
  @@index([providerRef])
  @@index([appId, status])
  @@map("hub_payments")
}

model ServicePayment {
  id            String        @id @default(uuid())
  referenceType String
  referenceId   String
  userId        String
  amountCdf     Int
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  providerRef   String?
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([referenceType, referenceId])
  @@map("service_payments")
}

model Wallet {
  id              String   @id @default(uuid())
  userId          String   @unique
  balanceCdf      Int      @default(0)
  heldBalanceCdf  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions WalletTransaction[]
  holds        WalletHold[]

  @@map("wallets")
}

model WalletHold {
  id            String   @id @default(uuid())
  walletId      String
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amountCdf     Int
  referenceType String
  referenceId   String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([referenceType, referenceId])
  @@index([walletId, status])
  @@map("wallet_holds")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amountCdf   Int
  type        String
  description String?
  reference   String?
  createdAt   DateTime @default(now())

  @@index([walletId])
  @@index([reference, type])
  @@map("wallet_transactions")
}

enum SubscriptionTarget {
  PASSENGER
  DRIVER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum CashDebtCategory {
  PLATFORM_FEE
  RESTAURANT_SHARE
  PARTNER_SHARE
}

enum CashDebtStatus {
  OPEN
  SETTLED
}

enum CashDebtCashRequestStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

model DriverCashDebtCashRequest {
  id            String                    @id @default(uuid())
  driverUserId  String                    @map("driver_user_id")
  amountCdf     Int                       @map("amount_cdf")
  code          String                    @unique
  status        CashDebtCashRequestStatus @default(PENDING)
  expiresAt     DateTime                  @map("expires_at")
  confirmedAt   DateTime?                 @map("confirmed_at")
  confirmedBy   String?                   @map("confirmed_by")
  settlementRef String?                   @map("settlement_ref")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  @@index([driverUserId, status])
  @@map("driver_cash_debt_cash_requests")
}

model DriverCashDebt {
  id                String           @id @default(uuid())
  driverUserId      String
  referenceType     String
  referenceId       String
  category          CashDebtCategory
  amountCdf         Int
  status            CashDebtStatus   @default(OPEN)
  beneficiaryUserId String?
  description       String?
  reference         String           @unique
  settledAt         DateTime?
  settlementRef     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([driverUserId, status])
  @@map("driver_cash_debts")
}

model DriverDebtPolicy {
  id             String   @id @default("default")
  maxOpenDebtCdf Int      @default(50000) @map("max_open_debt_cdf")
  blockOffers    Boolean  @default(true) @map("block_offers")
  isActive       Boolean  @default(true) @map("is_active")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("driver_debt_policies")
}

model SubscriptionPlan {
  id                  String             @id @default(uuid())
  code                String             @unique
  name                String
  target              SubscriptionTarget
  monthlyPriceCdf     Int
  feeReductionPercent Float              @default(0)
  priorityMatching    Boolean            @default(false)
  description         String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id        String             @id @default(uuid())
  userId    String
  planId    String
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("user_subscriptions")
}
