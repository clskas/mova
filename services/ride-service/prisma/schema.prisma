generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  MOTO_TAXI
  STANDARD
  COMFORT
  VIP
  UTILITAIRE
  CAMION
}

enum RideStatus {
  REQUESTED
  SEARCHING
  ACCEPTED
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryType {
  PARCEL
  FOOD
  EXPRESS
}

enum WeightCategory {
  DOCUMENTS
  SMALL
  MEDIUM
  LARGE
}

enum DeliveryStatus {
  PENDING
  RESTAURANT_CONFIRMED
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ScheduledRideStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Commune {
  id        String   @id @default(uuid())
  name      String
  city      String   @default("Kinshasa")
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@unique([name, city])
  @@map("communes")
}

model Province {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]

  @@map("provinces")
}

model City {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  centerLat  Float
  centerLng  Float
  minLat     Float
  maxLat     Float
  minLng     Float
  maxLng     Float
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name, provinceId])
  @@map("cities")
}

model PricingRule {
  id              String      @id @default(uuid())
  vehicleType     VehicleType
  city            String      @default("Kinshasa")
  baseFareCdf     Int
  perKmCdf        Int
  perMinuteCdf    Int
  minFareCdf      Int
  peakMultiplier  Float       @default(1.0)
  nightMultiplier Float       @default(1.0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([vehicleType, city])
  @@map("pricing_rules")
}

model CancellationPolicy {
  id                    String      @id @default(uuid())
  vehicleType           VehicleType @unique
  freeCancelMinutes     Int         @default(2)
  passengerFeeCdf       Int         @default(0)
  driverCompensationCdf Int         @default(0)
  noShowFeeCdf          Int         @default(2000)
  createdAt             DateTime    @default(now())

  @@map("cancellation_policies")
}

model Ride {
  id               String     @id @default(uuid())
  passengerId      String
  driverId         String?
  vehicleId        String?
  status           RideStatus @default(REQUESTED)
  vehicleType      VehicleType
  pickupLat        Float
  pickupLng        Float
  pickupAddress    String?
  dropoffLat       Float
  dropoffLng       Float
  dropoffAddress   String?
  estimatedFareCdf Int?
  finalFareCdf     Int?
  distanceKm       Float?
  durationMin      Float?
  acceptedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  cancelledBy      String?
  completionPin    String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  events  RideEvent[]
  ratings Rating[]

  @@index([status])
  @@index([passengerId])
  @@index([driverId])
  @@map("rides")
}

model RideEvent {
  id        String   @id @default(uuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  event     String
  lat       Float?
  lng       Float?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([rideId])
  @@map("ride_events")
}

model Rating {
  id         String   @id @default(uuid())
  rideId     String
  ride       Ride     @relation(fields: [rideId], references: [id])
  fromUserId String
  toUserId   String
  score      Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([rideId, fromUserId])
  @@map("ratings")
}

model Restaurant {
  id                String   @id @default(uuid())
  name              String
  cuisine           String
  address           String
  lat               Float
  lng               Float
  rating            Float    @default(4.0)
  imageUrl          String?
  promotionLabel    String?
  menuItems         Json?
  isActive          Boolean  @default(true)
  isAcceptingOrders Boolean  @default(true)
  prepTimeMin       Int      @default(25)
  ownerUserId       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  deliveries Delivery[]

  @@index([ownerUserId])
  @@map("restaurants")
}

model Delivery {
  id                String           @id @default(uuid())
  userId            String
  type              DeliveryType
  status            DeliveryStatus   @default(PENDING)
  pickupLat         Float?
  pickupLng         Float?
  pickupAddress     String?
  dropoffLat        Float?
  dropoffLng        Float?
  dropoffAddress    String?
  photoUrl          String?
  weightCategory    WeightCategory?
  restaurantId      String?
  restaurant        Restaurant?      @relation(fields: [restaurantId], references: [id])
  items             Json?
  deliveryAddress   String?
  deliveryLat       Float?
  deliveryLng       Float?
  driverId          String?
  deliveryPin       String?
  estimatedPriceCdf Int
  finalPriceCdf     Int?
  distanceKm        Float?
  durationMin       Float?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  events DeliveryEvent[]
  ratings DeliveryRating[]

  @@index([userId])
  @@index([status])
  @@map("deliveries")
}

model DeliveryEvent {
  id         String   @id @default(uuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  event      String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([deliveryId])
  @@map("delivery_events")
}

model DeliveryRating {
  id              String   @id @default(uuid())
  deliveryId      String
  delivery        Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  fromUserId      String
  restaurantScore Int
  courierScore    Int?
  comment         String?
  createdAt       DateTime @default(now())

  @@unique([deliveryId, fromUserId])
  @@map("delivery_ratings")
}

model ScheduledRide {
  id                String              @id @default(uuid())
  passengerId       String
  driverId          String?
  status            ScheduledRideStatus @default(SCHEDULED)
  vehicleType       VehicleType
  scheduledAt       DateTime
  pickupLat         Float
  pickupLng         Float
  pickupAddress     String?
  dropoffLat        Float
  dropoffLng        Float
  dropoffAddress    String?
  estimatedPriceCdf Int
  distanceKm        Float?
  durationMin       Float?
  cancelledAt       DateTime?
  cancelReason      String?
  rideId            String?
  completionPin     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([passengerId])
  @@index([scheduledAt])
  @@index([status])
  @@map("scheduled_rides")
}

enum CarpoolStatus {
  OPEN
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ErrandOrderStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RentalInquiryStatus {
  PENDING
  CONFIRMED
  CONTACTED
  IN_PROGRESS
  RETURNED
  CLOSED
}

enum RentalLogisticsMode {
  SELF_PASSENGER
  PASSENGER_DRIVER
  OWNER_DRIVER
  MOVA_DRIVER
}

enum MovingRequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MovingVehicleCategory {
  CAMIONNETTE
  CAMION_15M3
  CAMION_30M3
  CAMION_50M3
}

model CarpoolTrip {
  id                String        @id @default(uuid())
  driverId          String
  status            CarpoolStatus @default(OPEN)
  departureAt       DateTime
  pickupLat         Float
  pickupLng         Float
  pickupAddress     String?
  dropoffLat        Float
  dropoffLng        Float
  dropoffAddress    String?
  fromCity          String?
  toCity            String?
  meetingPoint      String?
  seatsTotal        Int           @default(3)
  seatsAvailable    Int
  pricePerSeatCdf   Int
  notes             String?
  ladiesOnly        Boolean       @default(false)
  instantBooking    Boolean       @default(true)
  vehicleInfo       String?
  distanceKm        Float?
  durationMin       Float?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  passengers CarpoolPassenger[]
  ratings    CarpoolRating[]

  @@index([driverId])
  @@index([status])
  @@index([departureAt])
  @@index([fromCity, toCity])
  @@map("carpool_trips")
}

model CarpoolRating {
  id         String      @id @default(uuid())
  tripId     String
  trip       CarpoolTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUserId String
  toUserId   String
  score      Int
  comment    String?
  createdAt  DateTime    @default(now())

  @@unique([tripId, fromUserId])
  @@index([toUserId])
  @@map("carpool_ratings")
}

model CarpoolPassenger {
  id        String   @id @default(uuid())
  tripId    String
  trip      CarpoolTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  seats     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([tripId, userId])
  @@index([userId])
  @@map("carpool_passengers")
}

model ErrandOrder {
  id                String            @id @default(uuid())
  userId            String
  status            ErrandOrderStatus @default(PENDING)
  description       String
  items             Json?
  budgetCdf         Int?
  purchaseTotalCdf  Int?
  finalPriceCdf     Int?
  proofPhotoUrl     String?
  completionPin     String?
  pickupAddress     String
  pickupLat         Float
  pickupLng         Float
  dropoffAddress    String
  dropoffLat        Float
  dropoffLng        Float
  estimatedPriceCdf Int
  distanceKm        Float?
  durationMin       Float?
  driverId          String?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@map("errand_orders")
}

model TripShareLink {
  id        String   @id @default(uuid())
  rideId    String
  token     String   @unique
  createdBy String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([rideId])
  @@map("trip_share_links")
}

model RentalVehicle {
  id                   String   @id @default(uuid())
  name                 String
  make                 String?
  model                String?
  year                 Int?
  category             String
  transmission         String   @default("MANUAL")
  city                 String   @default("Kinshasa")
  seats                Int
  dailyRateCdf         Int
  depositCdf           Int      @default(50000)
  weeklyDiscountPct    Int      @default(10)
  rating               Float    @default(4.5)
  ownerName            String?
  ownerBadge           String?
  ownerContactPhone    String?
  ownerUserId          String?
  approvalStatus       RentalVehicleApprovalStatus @default(APPROVED)
  features             Json?
  cancellationPolicy   String?
  mileageUnlimited     Boolean  @default(true)
  limitedMileageFeeCdf Int      @default(15000)
  imageUrl             String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bookings RentalInquiry[]

  @@index([city, category, isActive])
  @@index([ownerUserId])
  @@map("rental_vehicles")
}

enum RentalVehicleApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model RentalInquiry {
  id                String              @id @default(uuid())
  userId            String
  status            RentalInquiryStatus @default(PENDING)
  vehicleId         String?
  vehicle           RentalVehicle?      @relation(fields: [vehicleId], references: [id])
  vehicleType       String
  startDate         DateTime
  endDate           DateTime
  pickupAddress     String?
  pickupCity        String?
  returnCity        String?
  rentalPeriod      String              @default("DAILY")
  mileageType       String              @default("UNLIMITED")
  insuranceTier     String              @default("BASIC")
  addOns            Json?
  contactPhone      String?
  notes             String?
  estimatedPriceCdf Int?
  totalCdf          Int?
  logisticsMode           RentalLogisticsMode @default(SELF_PASSENGER)
  passengerDriverName     String?
  passengerDriverPhone    String?
  ownerDriverName         String?
  ownerDriverPhone        String?
  driverId                String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@index([driverId])
  @@map("rental_inquiries")
}

model MovingRequest {
  id                String              @id @default(uuid())
  userId            String
  status            MovingRequestStatus     @default(PENDING)
  volumeM3          Float
  vehicleCategory   MovingVehicleCategory   @default(CAMION_15M3)
  pickupLat         Float
  pickupLng         Float
  pickupAddress     String
  dropoffLat        Float
  dropoffLng        Float
  dropoffAddress    String
  estimatedPriceCdf Int
  distanceKm        Float?
  durationMin       Float?
  driverId          String?
  photoUrls         Json?
  itemsNotes        String?
  completionPin     String?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@map("moving_requests")
}

enum SurchargeType {
  DELIVERY_PARCEL
  DELIVERY_FOOD
  DELIVERY_EXPRESS
  MOVING
}

enum CommissionServiceType {
  RIDE
  DELIVERY
  MOVING
  RENTAL
  CARPOOL
  ERRAND
}

model PlatformCommission {
  id              String                @id @default(uuid())
  serviceType     CommissionServiceType @unique
  platformPercent Float                 @default(15)
  driverPercent   Float                 @default(85)
  fixedFeeCdf     Int?
  perItemFeeCdf   Int?
  description     String?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@map("platform_commissions")
}

model ServiceSurcharge {
  id          String        @id @default(uuid())
  type        SurchargeType @unique
  baseFeeCdf  Int           @default(0)
  multiplier  Float         @default(1.0)
  perUnitCdf  Int?
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("service_surcharges")
}

model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Int?
  discountCdf     Int?
  maxUses         Int?
  usedCount       Int       @default(0)
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("promo_codes")
}

enum TrackingReferenceType {
  RIDE
  DELIVERY
  ERRAND
  MOVING
}

model TrackingPoint {
  id            String                @id @default(uuid())
  referenceType TrackingReferenceType
  referenceId   String
  lat           Float
  lng           Float
  recordedAt    DateTime              @default(now())

  @@index([referenceType, referenceId, recordedAt])
  @@map("tracking_points")
}
