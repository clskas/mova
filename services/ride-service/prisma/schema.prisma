generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  MOTO_TAXI
  STANDARD
  COMFORT
  VIP
}

enum RideStatus {
  REQUESTED
  SEARCHING
  ACCEPTED
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryType {
  PARCEL
  FOOD
  EXPRESS
}

enum WeightCategory {
  DOCUMENTS
  SMALL
  MEDIUM
  LARGE
}

enum DeliveryStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ScheduledRideStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Commune {
  id        String   @id @default(uuid())
  name      String
  city      String   @default("Kinshasa")
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@unique([name, city])
  @@map("communes")
}

model PricingRule {
  id              String      @id @default(uuid())
  vehicleType     VehicleType
  city            String      @default("Kinshasa")
  baseFareCdf     Int
  perKmCdf        Int
  perMinuteCdf    Int
  minFareCdf      Int
  peakMultiplier  Float       @default(1.0)
  nightMultiplier Float       @default(1.0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([vehicleType, city])
  @@map("pricing_rules")
}

model CancellationPolicy {
  id                    String      @id @default(uuid())
  vehicleType           VehicleType @unique
  freeCancelMinutes     Int         @default(2)
  passengerFeeCdf       Int         @default(0)
  driverCompensationCdf Int         @default(0)
  noShowFeeCdf          Int         @default(2000)
  createdAt             DateTime    @default(now())

  @@map("cancellation_policies")
}

model Ride {
  id               String     @id @default(uuid())
  passengerId      String
  driverId         String?
  vehicleId        String?
  status           RideStatus @default(REQUESTED)
  vehicleType      VehicleType
  pickupLat        Float
  pickupLng        Float
  pickupAddress    String?
  dropoffLat       Float
  dropoffLng       Float
  dropoffAddress   String?
  estimatedFareCdf Int?
  finalFareCdf     Int?
  distanceKm       Float?
  durationMin      Float?
  acceptedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  cancelledBy      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  events  RideEvent[]
  ratings Rating[]

  @@index([status])
  @@index([passengerId])
  @@index([driverId])
  @@map("rides")
}

model RideEvent {
  id        String   @id @default(uuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  event     String
  lat       Float?
  lng       Float?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([rideId])
  @@map("ride_events")
}

model Rating {
  id         String   @id @default(uuid())
  rideId     String
  ride       Ride     @relation(fields: [rideId], references: [id])
  fromUserId String
  toUserId   String
  score      Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([rideId, fromUserId])
  @@map("ratings")
}

model Restaurant {
  id        String   @id @default(uuid())
  name      String
  cuisine   String
  address   String
  lat       Float
  lng       Float
  rating    Float    @default(4.0)
  imageUrl  String?
  menuItems Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries Delivery[]

  @@map("restaurants")
}

model Delivery {
  id                String           @id @default(uuid())
  userId            String
  type              DeliveryType
  status            DeliveryStatus   @default(PENDING)
  pickupLat         Float?
  pickupLng         Float?
  pickupAddress     String?
  dropoffLat        Float?
  dropoffLng        Float?
  dropoffAddress    String?
  photoUrl          String?
  weightCategory    WeightCategory?
  restaurantId      String?
  restaurant        Restaurant?      @relation(fields: [restaurantId], references: [id])
  items             Json?
  deliveryAddress   String?
  deliveryLat       Float?
  deliveryLng       Float?
  driverId          String?
  deliveryPin       String?
  estimatedPriceCdf Int
  finalPriceCdf     Int?
  distanceKm        Float?
  durationMin       Float?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  events DeliveryEvent[]

  @@index([userId])
  @@index([status])
  @@map("deliveries")
}

model DeliveryEvent {
  id         String   @id @default(uuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  event      String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([deliveryId])
  @@map("delivery_events")
}

model ScheduledRide {
  id                String              @id @default(uuid())
  passengerId       String
  driverId          String?
  status            ScheduledRideStatus @default(SCHEDULED)
  vehicleType       VehicleType
  scheduledAt       DateTime
  pickupLat         Float
  pickupLng         Float
  pickupAddress     String?
  dropoffLat        Float
  dropoffLng        Float
  dropoffAddress    String?
  estimatedPriceCdf Int
  distanceKm        Float?
  durationMin       Float?
  cancelledAt       DateTime?
  cancelReason      String?
  rideId            String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([passengerId])
  @@index([scheduledAt])
  @@index([status])
  @@map("scheduled_rides")
}

enum CarpoolStatus {
  OPEN
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ErrandOrderStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RentalInquiryStatus {
  PENDING
  CONFIRMED
  CONTACTED
  IN_PROGRESS
  RETURNED
  CLOSED
}

enum MovingRequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CarpoolTrip {
  id                String        @id @default(uuid())
  driverId          String
  status            CarpoolStatus @default(OPEN)
  departureAt       DateTime
  pickupLat         Float
  pickupLng         Float
  pickupAddress     String?
  dropoffLat        Float
  dropoffLng        Float
  dropoffAddress    String?
  fromCity          String?
  toCity            String?
  meetingPoint      String?
  seatsTotal        Int           @default(3)
  seatsAvailable    Int
  pricePerSeatCdf   Int
  notes             String?
  ladiesOnly        Boolean       @default(false)
  instantBooking    Boolean       @default(true)
  vehicleInfo       String?
  distanceKm        Float?
  durationMin       Float?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  passengers CarpoolPassenger[]
  ratings    CarpoolRating[]

  @@index([driverId])
  @@index([status])
  @@index([departureAt])
  @@index([fromCity, toCity])
  @@map("carpool_trips")
}

model CarpoolRating {
  id         String      @id @default(uuid())
  tripId     String
  trip       CarpoolTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUserId String
  toUserId   String
  score      Int
  comment    String?
  createdAt  DateTime    @default(now())

  @@unique([tripId, fromUserId])
  @@index([toUserId])
  @@map("carpool_ratings")
}

model CarpoolPassenger {
  id        String   @id @default(uuid())
  tripId    String
  trip      CarpoolTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  seats     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([tripId, userId])
  @@index([userId])
  @@map("carpool_passengers")
}

model ErrandOrder {
  id                String            @id @default(uuid())
  userId            String
  status            ErrandOrderStatus @default(PENDING)
  description       String
  pickupAddress     String
  pickupLat         Float
  pickupLng         Float
  dropoffAddress    String
  dropoffLat        Float
  dropoffLng        Float
  estimatedPriceCdf Int
  distanceKm        Float?
  durationMin       Float?
  driverId          String?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@map("errand_orders")
}

model RentalVehicle {
  id                   String   @id @default(uuid())
  name                 String
  make                 String?
  model                String?
  year                 Int?
  category             String
  transmission         String   @default("MANUAL")
  city                 String   @default("Kinshasa")
  seats                Int
  dailyRateCdf         Int
  depositCdf           Int      @default(50000)
  weeklyDiscountPct    Int      @default(10)
  rating               Float    @default(4.5)
  ownerName            String?
  ownerBadge           String?
  ownerContactPhone    String?
  features             Json?
  cancellationPolicy   String?
  mileageUnlimited     Boolean  @default(true)
  limitedMileageFeeCdf Int      @default(15000)
  imageUrl             String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bookings RentalInquiry[]

  @@index([city, category, isActive])
  @@map("rental_vehicles")
}

model RentalInquiry {
  id                String              @id @default(uuid())
  userId            String
  status            RentalInquiryStatus @default(PENDING)
  vehicleId         String?
  vehicle           RentalVehicle?      @relation(fields: [vehicleId], references: [id])
  vehicleType       String
  startDate         DateTime
  endDate           DateTime
  pickupAddress     String?
  pickupCity        String?
  returnCity        String?
  rentalPeriod      String              @default("DAILY")
  mileageType       String              @default("UNLIMITED")
  insuranceTier     String              @default("BASIC")
  addOns            Json?
  contactPhone      String?
  notes             String?
  estimatedPriceCdf Int?
  totalCdf          Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@map("rental_inquiries")
}

model MovingRequest {
  id                String              @id @default(uuid())
  userId            String
  status            MovingRequestStatus @default(PENDING)
  volumeM3          Float
  pickupLat         Float
  pickupLng         Float
  pickupAddress     String
  dropoffLat        Float
  dropoffLng        Float
  dropoffAddress    String
  estimatedPriceCdf Int
  distanceKm        Float?
  durationMin       Float?
  driverId          String?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@map("moving_requests")
}

enum SurchargeType {
  DELIVERY_PARCEL
  DELIVERY_FOOD
  DELIVERY_EXPRESS
  MOVING
}

model ServiceSurcharge {
  id          String        @id @default(uuid())
  type        SurchargeType @unique
  baseFeeCdf  Int           @default(0)
  multiplier  Float         @default(1.0)
  perUnitCdf  Int?
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("service_surcharges")
}

model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Int?
  discountCdf     Int?
  maxUses         Int?
  usedCount       Int       @default(0)
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("promo_codes")
}
